
main.tf ka code

variable "rg_name" {
  type = map(string)
}

variable "storage_account" {
  type = map(object({
    name = string
    rg   = string
  }))
}
resource "azurerm_resource_group" "rg_name" {
  for_each = var.rg_name

  name     = each.key
  location = each.value
}

resource "azurerm_storage_account" "storage_account" {
  for_each = var.storage_account

  name                     = each.value.name
  resource_group_name      = azurerm_resource_group.rg_name[each.value.rg].name
  location                 = azurerm_resource_group.rg_name[each.value.rg].location
  account_tier             = "Standard"
  account_replication_type = "LRS"
}

